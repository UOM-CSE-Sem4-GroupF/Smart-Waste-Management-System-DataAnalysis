APP_ENV=dev
LOG_LEVEL=INFO

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INPUT_TOPIC=waste.bin.telemetry
KAFKA_OUTPUT_TOPIC=waste.bin.processed
KAFKA_ZONE_INPUT_TOPIC=waste.bin.processed
KAFKA_ZONE_OUTPUT_TOPIC=waste.zone.statistics
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_USERNAME=
KAFKA_PASSWORD=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=waste_management
POSTGRES_USER=waste_admin
POSTGRES_PASSWORD=waste_admin_password

INFLUX_URL=http://localhost:8086
INFLUX_ORG=waste-org
INFLUX_TOKEN=my-super-token
INFLUX_RAW_BUCKET=bin_readings_raw
INFLUX_PROCESSED_BUCKET=bin_readings_processed
INFLUX_ZONE_BUCKET=bin_readings_processed

PROCESSING_TIMEZONE=UTC
LOCAL_TEST_INPUT_FILE=./tests/data/bin_telemetry_sample.jsonl
LOCAL_ZONE_TEST_INPUT_FILE=./tests/data/processed_bin_sample.jsonl
