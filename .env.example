# Example Environment Configuration
# Copy this file to .env before running Docker

# MQTT Configuration
MQTT_HOST=localhost
MQTT_PORT=1883

# Kafka Configuration
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_INTERNAL_HOST=kafka
KAFKA_INTERNAL_PORT=29092

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=waste_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword

# InfluxDB Configuration
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_ORG=my-org
INFLUXDB_BUCKET=waste-data
INFLUXDB_TOKEN=change-me-token

# Deployment Mode: local, docker, server
DEPLOYMENT_MODE=local

# Prediction horizon configuration (minutes)
PRED_HORIZON_5MIN=5
PRED_HORIZON_4HOUR=240
PRED_HORIZON_1DAY=1440
PRED_HORIZON_7DAY=10080
