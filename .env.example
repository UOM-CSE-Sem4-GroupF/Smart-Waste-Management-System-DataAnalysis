# Example Environment Configuration
# Copy this file to .env and modify values for your deployment

# MQTT Configuration
MQTT_HOST=localhost
MQTT_PORT=1883

# Kafka Configuration
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_INTERNAL_HOST=kafka
KAFKA_INTERNAL_PORT=29092

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=waste_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword

# InfluxDB Configuration
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_ORG=my-org
INFLUXDB_BUCKET=waste-data
INFLUXDB_TOKEN=-76pFpLPoer9mtJwh_ewyXzCt0tWDvpPfl76OsjhYit36g6Sp8Kvs3s4mrvuSEIqWCZoq4CL_NXsO0h6_cpY1Q==

# Deployment Mode: local, docker, server
DEPLOYMENT_MODE=local
